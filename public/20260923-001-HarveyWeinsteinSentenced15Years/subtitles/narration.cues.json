[
  {
    "text": "Harvey Weinstein just got",
    "start": 0.14,
    "end": 1.53
  },
  {
    "text": "15 years",
    "start": 1.53,
    "end": 2.29
  },
  {
    "text": "and he still won't",
    "start": 2.29,
    "end": 3.05
  },
  {
    "text": "say he's guilty.",
    "start": 3.05,
    "end": 3.98
  },
  {
    "text": "Picture it, 74",
    "start": 3.98,
    "end": 4.96
  },
  {
    "text": "wheeled into Manhattan court,",
    "start": 4.96,
    "end": 6.37
  },
  {
    "text": "hands cuffed to the chair,",
    "start": 6.37,
    "end": 7.75
  },
  {
    "text": "Prosecutors wanted 20,",
    "start": 7.75,
    "end": 9.32
  },
  {
    "text": "His lawyers begged for nine.",
    "start": 9.32,
    "end": 10.72
  },
  {
    "text": "Then Miriam Haley stood up.",
    "start": 11.5,
    "end": 13.6
  },
  {
    "text": "Former Project Runway assistant,",
    "start": 13.6,
    "end": 14.98
  },
  {
    "text": "she called it a",
    "start": 14.98,
    "end": 15.34
  },
  {
    "text": "life sentence for her",
    "start": 15.34,
    "end": 16.24
  },
  {
    "text": "after testifying twice",
    "start": 16.24,
    "end": 17.37
  },
  {
    "text": "through an overturned conviction",
    "start": 17.37,
    "end": 19.02
  },
  {
    "text": "and a 2025 retrial.",
    "start": 19.02,
    "end": 20.63
  },
  {
    "text": "And this is wild,",
    "start": 20.63,
    "end": 21.52
  },
  {
    "text": "he said he feels bad",
    "start": 21.52,
    "end": 22.51
  },
  {
    "text": "for Haley,",
    "start": 22.51,
    "end": 23.13
  },
  {
    "text": "then said he's innocent.",
    "start": 23.13,
    "end": 24.55
  },
  {
    "text": "Judge Farber wasn't having it.",
    "start": 24.55,
    "end": 26.4
  },
  {
    "text": "\"You took what you wanted",
    "start": 26.54,
    "end": 27.7
  },
  {
    "text": "by force,\" he said.",
    "start": 27.7,
    "end": 28.69
  },
  {
    "text": "\"And you have never",
    "start": 28.71,
    "end": 29.56
  },
  {
    "text": "accepted responsibility.\"",
    "start": 29.56,
    "end": 31.2
  },
  {
    "text": "Six years of appeals,",
    "start": 31.2,
    "end": 32.35
  },
  {
    "text": "same charge,",
    "start": 32.35,
    "end": 33.08
  },
  {
    "text": "15 years,",
    "start": 33.08,
    "end": 33.92
  },
  {
    "text": "plus sex-offender registration,",
    "start": 34.1,
    "end": 36.0
  },
  {
    "text": "so justice delayed",
    "start": 36.0,
    "end": 37.63
  },
  {
    "text": "or unfinished?",
    "start": 37.63,
    "end": 38.61
  },
  {
    "text": "Comment below.",
    "start": 38.61,
    "end": 39.471
  }
]
